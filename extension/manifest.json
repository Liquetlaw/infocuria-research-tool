{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "version": "1.1.0",
  "description": "__MSG_beschreibung__",
  "default_locale": "de",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "background": {
    "service_worker": "hintergrund.js"
  },
  "action": {
    "default_title": "__MSG_titel__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://juris.curia.europa.eu/juris/document/*",
        "https://curia.europa.eu/juris/document/*"
      ],
      "js": [
        "lesen.js",
        "zitierstil.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
